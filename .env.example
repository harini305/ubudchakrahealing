# Public site URL for canonical links, sitemap and Open Graph. Optional on Vercel
# (defaults to the project production domain); set it once the real domain points here.
NEXT_PUBLIC_SITE_URL=https://www.ubudchakrahealing.com

# Contact form delivery via Resend (https://resend.com). Until all three are set,
# the form validates input but tells visitors to email or call instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
